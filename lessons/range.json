    {
      "id": "w9",
      "title": "A batch, minus one jar",
      "unlocks_after": "lesson6",
      "rings": "after",
      "target": "Pick every jar in batch B05 except Q-053.",
      "targets": [
        "Q-051",
        "Q-052",
        "Q-054",
        "Q-055",
        "Q-056"
      ],
      "rule": null,
      "hint": "The sign .& joins two yes-or-no answers, one jar at a time. Ask one question about the batch and one about the jar_id, each in round brackets.",
      "example": "logbook[(logbook.batch_id.==\"B05\").&(logbook.jar_id.!=\"Q-053\"),:]",
      "check": {
        "requires_any": [
          "==",
          "!=",
          "∈",
          "∉",
          "in(",
          " in ",
          "occursin",
          "startswith",
          "filter",
          "in.(",
          "≠",
          "≥",
          "≤",
          "isequal",
          ".>",
          ".<"
        ],
        "forbids": [
          "Q-051",
          "Q-052",
          "Q-054",
          "Q-055",
          "Q-056"
        ]
      },
      "feedback": {
        "requires": "Aim with a rule this time: ask each jar a question, do not name the jars or count rows.",
        "forbids": "Aim with a rule this time: only Q-053 may be named. Ask each jar a question for the rest."
      }
    },
    {
      "id": "w10",
      "title": "Flip, then two more",
